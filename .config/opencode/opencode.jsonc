{
  "plugins": [
    "@slkiser/opencode-quota@6.3.0",
    "@tarquinen/opencode-dcp@3.2.0",
    "oh-my-opencode-slim@3.0.7",
    "-opencode.provider.github.copilot"
  ],
  "policies": [
    {
      "action": "provider.use",
      "resource": "github-copilot*",
      "effect": "deny"
    }
  ],
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "quotaToast": {
      "enabled": true,
      "enableToast": false,
      "enabledProviders": "auto",
      "formatStyle": "allWindows",
      "percentDisplayMode": "remaining",
      "showSessionTokens": true,
      "tuiSidebarPanel": {
        "enabled": false
      },
      "tuiCompactStatus": {
        "enabled": false,
        "homeBottom": false,
        "sessionPrompt": false,
        "suppressWhenNativeProviderQuota": true
      },
      "maintainerAnnouncements": {
        "enabled": false,
        "home": false
      }
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "permission": {
    "external_directory": "ask"
  },
  "lsp": true,
  "mcp": {
    "servers": {
      "firefox": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@mozilla/firefox-devtools-mcp@latest",
          "--connect-existing"
        ]
      }
    }
  }
}
